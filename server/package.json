{
  "name": "movie-graphql-server",
  "version": "1.0.0",
  "description": "TypeScript GraphQL server for TMDB API with Apollo Server 5",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "compile": "tsc",
    "start": "npm run compile && node ./dist/index.js",
    "postbuild": "cp src/schema.graphql dist/schema.graphql || true",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "graphql",
    "apollo-server",
    "typescript",
    "tmdb",
    "movies",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "axios": "^1.7.3",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "graphql": "^16.9.0"
  },
  "devDependencies": {
    "@graphql-tools/schema": "^10.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.10",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}