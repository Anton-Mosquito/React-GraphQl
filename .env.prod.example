# Production Environment Variables Template
# Copy this file to .env.prod and fill in your production values

# Database (use strong credentials in production!)
POSTGRES_DB=appdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-password-here

# Server URLs
CLIENT_URL=https://your-domain.com
API_URL=https://your-domain.com/api

# TMDB API
TMDB_API_KEY=your-tmdb-api-key
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_PATH=https://image.tmdb.org/t/p

# JWT Secrets (generate strong random strings!)
# Example: openssl rand -base64 64
JWT_ACCESS_SECRET=your-super-secret-access-token-at-least-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-token-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Email (Gmail OAuth2)
MAIL_USER=your-email@gmail.com
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret
OAUTH_REFRESH_TOKEN=your-oauth-refresh-token

# Nginx
HTTP_PORT=80
# HTTPS_PORT=443  # Uncomment when SSL is configured
